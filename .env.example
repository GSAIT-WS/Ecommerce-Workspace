# Supabase (required for Edge Functions, auth, addresses, checkout)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-side only (never VITE_*). From Dashboard → Settings → API → service_role.
# Used by scripts/create-ecommerce-test-user.mjs: npm run create-test-user
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Deploy: apply all migrations and functions to the same Supabase project, e.g.
#   supabase db push
#   supabase functions deploy
# New checkout functions: confirm-mock-payment, finalize-cod-order
#
# Auth: for Google sign-in, enable the Google provider in Dashboard → Authentication → Providers.
# Phone OTP requires an SMS provider (Twilio, etc.); the app uses email OTP + password by default.
#
# Payments: mock confirmation uses confirm-mock-payment (calls process_payment_webhook).
# payment-webhook remains for real providers; set WEBHOOK_SECRET in production and verify signatures.
