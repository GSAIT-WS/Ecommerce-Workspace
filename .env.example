# Supabase Edge Functions
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Webhook signature verification (optional in dev)
WEBHOOK_SECRET=your-webhook-secret

# CORS origin (optional — defaults to *)
CORS_ORIGIN=http://localhost:8080

# IMS (Inventory Management System) — HTTP API for stock reservation/release
# If IMS_BASE_URL is not set, IMS calls are skipped (dev mode)
IMS_BASE_URL=https://ims.example.com/api
IMS_API_KEY=your-ims-api-key
